---
const API_URL = import.meta.env.PUBLIC_API_URL || 'https://TUDOMINIO.workers.dev/api/data';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Musgo que respira — Monitor</title>
    <style>
      html,body{height:100%;margin:0;font-family:Inter, system-ui, Arial;display:flex;align-items:center;justify-content:center;background:#0b1220;color:#e6f1ff}
      .card{width:360px;padding:20px;border-radius:12px;background:linear-gradient(180deg,#07101a, #0f2130);box-shadow:0 6px 18px rgba(0,0,0,0.6);}
      .big{font-size:48px;font-weight:700}
      .muted{opacity:0.75}
      .dot{display:inline-block;width:12px;height:12px;border-radius:50%;margin-right:8px}
    </style>
  </head>
  <body>
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <div>
          <div class="muted">Musgo que respira</div>
          <div class="muted" style="font-size:12px">Monitor ESP32 — datos en línea</div>
        </div>
        <div id="status" class="muted">conectando...</div>
      </div>

      <div style="display:flex;align-items:center;gap:14px">
        <div>
          <div class="big" id="hum">--%</div>
          <div class="muted" id="estado">--</div>
        </div>
        <div style="margin-left:auto;text-align:right">
          <div class="muted" style="font-size:12px">Última</div>
          <div id="ts" class="muted">--</div>
        </div>
      </div>

      <div style="height:1px;background:rgba(255,255,255,0.04);margin:16px 0;border-radius:2px"></div>

      <div style="display:flex;gap:8px;align-items:center">
        <span id="led" class="dot" style="background:#666"></span>
        <div class="muted" id="info">esperando datos...</div>
      </div>

      <script>
        const api = '" + API_URL + "'.replace(/"/g,'');
        const estadoText = ["SECO","MEDIO","HUMEDO"];
        async function fetchOnce(){
          try{
            const res = await fetch(api);
            if(!res.ok) throw new Error(res.status);
            const j = await res.json();
            document.getElementById('hum').textContent = j.humidity + '%';
            document.getElementById('estado').textContent = estadoText[j.state] || 'DESCONOCIDO';
            document.getElementById('ts').textContent = new Date(j.ts || Date.now()).toLocaleTimeString();
            document.getElementById('info').textContent = JSON.stringify(j);
            document.getElementById('status').textContent = 'en línea';
            const c = j.humidity < 30 ? '#ff4d4f' : (j.humidity < 60 ? '#ffb84d' : '#4de37f');
            document.getElementById('led').style.background = c;
          }catch(e){
            document.getElementById('status').textContent = 'sin conexión';
            document.getElementById('info').textContent = e.message;
          }
        }
        // Poll cada 1s
        fetchOnce();
        setInterval(fetchOnce, 1000);
      </script>
    </div>
  </body>
</html>